{
  "name": "degreeplanner",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Front-end-only degree audit and program explorer",
  "scripts": {
    "build": "tailwindcss -i css/input.css -o css/app.css --minify",
    "watch": "tailwindcss -i css/input.css -o css/app.css --watch",
    "serve": "python3 serve.py 8080",
    "validate": "node tools/validate.mjs && node tools/smoke.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node tools/gen-index.mjs rice && node tools/validate.mjs && node tools/smoke.mjs && node --test tests/*.test.mjs && npm run lint",
    "bundle": "node tools/gen-index.mjs rice",
    "lint": "eslint js tools tests sw.js --max-warnings 30"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "eslint": "^9.39.5",
    "tailwindcss": "^4.1.0"
  }
}